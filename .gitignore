unity/DrosobotLab/Assets/Resources/CNS/
unity/DrosobotLab/Assets/Resources/CNS.meta
unity_assets/

# Dados do Male CNS: 1 GB de feather + 200 MB de CSR derivado.
# Reconstroi com benchmarks/neural/build_csr.py a partir dos downloads
# listados em docs/research/WHOLE_CNS_GPU_FEASIBILITY.md.
data/male-cns/

# venv paralelo do FlyGym 2.x (Python 3.14). Reconstroi com:
#   uv venv --python 3.14 .venv-flygym2
#   uv pip install --python .venv-flygym2/Scripts/python.exe -e research/upstream/flygym pyopencl
.venv-flygym2/

# malhas do NeuroMechFly convertidas. Reconstroi com:
#   .venv-flygym2\Scripts\python tools\export_fly_mesh.py
unity/DrosobotLab/Assets/Resources/Fly/*.obj
unity/DrosobotLab/Assets/Resources/Fly/*.obj.meta
